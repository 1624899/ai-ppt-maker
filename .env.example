# 可选：复制为 .env 后填写真实端点与密钥。
# Base URL 和 API Key 也可以在 Web 界面的“模型配置”中录入，系统会自动写入本地 .env。
PPT_SYSTEM_CHAT_CHAT_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
PPT_SYSTEM_CHAT_CHAT_OPENAI_COMPATIBLE_API_KEY=sk-your-chat-api-key
PPT_SYSTEM_IMAGE_IMAGE_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
PPT_SYSTEM_IMAGE_IMAGE_OPENAI_COMPATIBLE_API_KEY=sk-your-image-api-key
